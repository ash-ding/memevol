Bootstrap: docker
From: python:3.12-slim

%files
    containers/base_requirements_cpu.txt /opt/base_requirements.txt

%post
    set -e
    echo "=== pre-apt check ===" && ls -la /opt/base_requirements.txt

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

    echo "=== post-apt check ===" && ls -la /opt/base_requirements.txt

    python -m pip install --no-cache-dir --upgrade pip setuptools wheel
    pip install --no-cache-dir -r /opt/base_requirements.txt
    rm /opt/base_requirements.txt

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%labels
    Author ding
    Purpose forge-eval-base
    Python 3.12
    Torch 2.6.0-cpu
