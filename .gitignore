# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Data (too large for git or out-of-policy to ship in repo)
datasets/dynamicmem/user_data/
datasets/dynamicmem/user_qa/
datasets/locomo/locomo10.json
datasets/longmemeval/*.json

# Environment secrets
.env

# Local scratch docs (not part of the project)
docs/

# Claude Code local settings
.claude/
CLAUDE.md
PROGRESS.md
PROGRESS.zh.md

# --- alma baseline runtime artifacts ---
# Checkpoints, rotating log files, archived eval logs
baselines/alma/logs/*
!baselines/alma/logs/.gitkeep

# Generated (LLM-written) memo code is not checked in
baselines/alma/memo_archive/dynamicmem/*
!baselines/alma/memo_archive/dynamicmem/.gitkeep
baselines/alma/memo_archive/locomo/*
!baselines/alma/memo_archive/locomo/.gitkeep
baselines/alma/memo_archive/longmemeval_s/*
!baselines/alma/memo_archive/longmemeval_s/.gitkeep
baselines/alma/memo_archive/longmemeval_m/*
!baselines/alma/memo_archive/longmemeval_m/.gitkeep

# Runtime staging for the eval subprocess (per-SHA to avoid concurrent-run races)
baselines/alma/memo_test/memo_test_*.py

# Per-run eval outputs (score.json + traces + memory dumps)
baselines/alma/results/
baselines/cc/results/
baselines/hipporag2/results/

# --- Other baselines' runtime artifacts ---
baselines/*/outputs/
baselines/*/logs/
baselines/*/results/*_dryrun.json

# --- meta-harness runtime artifacts ---
baselines/meta-harness/archive/
baselines/meta-harness/results/
baselines/meta-harness/logs/

# --- forge runtime artifacts ---
# Per-run workspaces (workspace/<run_id>/...) hold all generated harnesses,
# eval outputs, and frontier snapshots. Seeds live under top-level seeds/
# and ARE git-tracked.
workspace/

# forge rotating logs
forge/logs/*
!forge/logs/.gitkeep

# Built Singularity images (too large for git; stored on /export/scratch_large)
containers/*.sif
