# Virtual environments (uv sync creates .venv/ per project — root + each baseline)
.venv/
venv/
memevol_env/
# uv.lock and pyproject.toml ARE tracked (reproducible envs); .venv/ is not.

# Python cache
__pycache__/
*.pyc
*.pyo

# Data (too large for git or out-of-policy to ship in repo)
benchmarks/dynamicmem/user_data/
benchmarks/dynamicmem/user_qa/
benchmarks/locomo/locomo10.json
benchmarks/longmemeval/*.json

# Environment secrets
.env

# Local scratch docs (not part of the project)
docs/

# Claude Code local settings
.claude/
CLAUDE.md
PROGRESS.md
PROGRESS.zh.md

# --- alma baseline runtime artifacts ---
# Checkpoints, rotating log files, archived eval logs
baselines/evolve/alma/logs/*
!baselines/evolve/alma/logs/.gitkeep

# Generated (LLM-written) memo code is not checked in
baselines/evolve/alma/memo_archive/dynamicmem/*
!baselines/evolve/alma/memo_archive/dynamicmem/.gitkeep
baselines/evolve/alma/memo_archive/locomo/*
!baselines/evolve/alma/memo_archive/locomo/.gitkeep
baselines/evolve/alma/memo_archive/longmemeval_s/*
!baselines/evolve/alma/memo_archive/longmemeval_s/.gitkeep

# Runtime staging for the eval subprocess (per-SHA to avoid concurrent-run races)
baselines/evolve/alma/memo_test/memo_test_*.py

# Per-run eval outputs (score.json + traces + memory dumps)
baselines/evolve/alma/results/
baselines/harness/hipporag2/results/
baselines/harness/amem/results/
baselines/harness/lightmem/results/
baselines/harness/lightmem/smoke_*.yaml
baselines/harness/simplemem/results/
baselines/harness/zep/results/

# --- Other baselines' runtime artifacts (evolve/<name>/ + harness/<name>/) ---
baselines/*/*/outputs/
baselines/*/*/logs/
baselines/*/*/results/*_dryrun.json

# --- meta-harness runtime artifacts ---
baselines/meta-harness/archive/
baselines/meta-harness/results/
baselines/meta-harness/logs/

# --- forge runtime artifacts ---
# Per-run workspaces (workspace/<run_id>/...) hold all generated harnesses,
# eval outputs, and frontier snapshots. Seeds live under top-level seeds/
# and ARE git-tracked.
workspace/

# forge rotating logs
forge/logs/*
!forge/logs/.gitkeep

# Built Singularity images (too large for git; stored on /export/scratch_large)
containers/*.sif
memevol_env/

# mem0 / memoryos runtime artifacts (per-user Qdrant + MemoryOS stores)
baselines/harness/mem0/results/
baselines/harness/mem0/outputs/
baselines/harness/memoryos/results/
baselines/harness/memoryos/outputs/
