# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Data (too large for git)
dynamicmem/user_data/
dynamicmem/user_qa/

# Runtime artifacts
logs/*
!logs/.gitkeep
evals/logs/*
!evals/logs/.gitkeep
evals/memo_test/memo_test.py

# Evolved memo structures (generated at runtime)
memo_archive/dynamicmem/*
!memo_archive/dynamicmem/.gitkeep

# Environment secrets
.env

# Local scratch docs (not part of the project)
docs/

# Claude Code local settings
.claude/

# Baseline runtime artifacts (regenerated on each run)
baselines/*/outputs/
baselines/*/logs/
baselines/*/results/*_dryrun.json
